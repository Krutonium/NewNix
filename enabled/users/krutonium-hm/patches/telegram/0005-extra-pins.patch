+	// Chat pins.
+	void serverChatsApplied(const std::vector<PeerId> &serverPinned);
+	void serverEntryPinned(not_null<History*> history, bool pinned);
+	[[nodiscard]] bool keepLocalPin(not_null<History*> history) const;
+	void chatPinnedLocally(not_null<History*> history, bool pinned);
+	[[nodiscard]] std::vector<PeerId> extraPinnedPeerIds() const;
+	[[nodiscard]] bool isExtraPeer(PeerId peerId) const;
+
+	// Faved stickers.
+	void serverFavedReceived(const QVector<DocumentData*> &serverFaved);
+	void chatFavedLocal(not_null<DocumentData*> document);
+	void chatFavedNotLocal(not_null<DocumentData*> document);
+	[[nodiscard]] QVector<DocumentData*> extraFavedDocuments() const;
+
+	// Sync with the Saved Messages chat.
+	void push(std::shared_ptr<ChatHelpers::Show> show);
+	void pull(std::shared_ptr<ChatHelpers::Show> show);
+
+private:
+	void ensureLoaded();
+	void persistChats();
+	void persistFaved();
+	void readBackup(
+		std::shared_ptr<ChatHelpers::Show> show,
+		std::vector<MsgId> messageIds);
+	void applyBackup(
+		std::shared_ptr<ChatHelpers::Show> show,
+		const QString &path);
+	[[nodiscard]] Main::Session &session() const;
+	[[nodiscard]] Data::Session &data() const;
+
+	const not_null<Main::Session*> _session;
+
+	QVector<PeerId> _extraPinnedChats;
+	base::flat_set<PeerId> _serverPinnedChats;
+
+	QVector<uint64> _extraFavedStickers;
+	base::flat_set<uint64> _serverFavedStickers;
+
+	bool _loaded = false;
+	bool _pulling = false;
+
+};
