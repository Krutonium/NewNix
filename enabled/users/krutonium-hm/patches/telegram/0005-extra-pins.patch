+void PinExtrasBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session) {
+	box->setTitle(tr::lng_pin_extras_box_title());
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			tr::lng_pin_extras_box_about(),
+			st::boxLabel),
+		st::boxRowPadding);
+
+	// The box is always created by a session controller, so the underlying
+	// show chain is a ChatHelpers::Show instance.
+	const auto show = std::static_pointer_cast<ChatHelpers::Show>(
+		box->uiShow());
+
+	box->addButton(tr::lng_pin_extras_export(), [=] {
+		session->data().pinExtras().push(show);
+		box->closeBox();
+	});
+
+	box->addButton(tr::lng_pin_extras_import(), [=] {
+		session->data().pinExtras().pull(show);
+		box->closeBox();
+	});
+
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
