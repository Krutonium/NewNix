+class PinExtras final {
+public:
+	explicit PinExtras(not_null<Main::Session*> session);
+
+	// The server caps pinned chats and faved stickers at Premium limits,
+	// so everything beyond those limits is kept as a local "extras" overlay,
+	// persisted between launches and synced through a JSON file in the
+	// user's own Saved Messages chat.
+	static constexpr auto kPinnedChatsLimit = 20;
+	static constexpr auto kFavedStickersLimit = 20;
