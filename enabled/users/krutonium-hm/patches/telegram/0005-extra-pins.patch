@@ -0,0 +1,400 @@
+/*
+This file is part of Telegram Desktop,
+the official application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#include "data/data_pin_extras.h"
+
+#include "api/api_common.h"
+#include "apiwrap.h"
+#include "chat_helpers/compose/compose_show.h"
+#include "data/data_document.h"
+#include "data/data_file_origin.h"
+#include "data/data_media_types.h"
+#include "data/data_msg_id.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/stickers/data_stickers.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "lang/lang_keys.h"
+#include "main/main_session.h"
+#include "mtproto/mtproto_response.h"
+#include "storage/localimageloader.h"
+#include "storage/storage_account.h"
+#include "ui/image/image_location.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QTimer>
+
+namespace {
+
+constexpr auto kChatsPrefKey = "pinExtras.chats";
+constexpr auto kFavedPrefKey = "pinExtras.faved";
+constexpr auto kBackupFileName = "tdesktop-pin-extras.json";
+constexpr auto kBackupKind = "tdesktop-pin-extras";
+constexpr auto kPullLimit = 100;
+constexpr auto kPollInterval = crl::time(100);
+constexpr auto kPollAttempts = 150;
+
+[[nodiscard]] QJsonValue SerializeId(uint64 id) {
+	return QString::number(id);
+}
+
+[[nodiscard]] uint64 ParseId(const QJsonValue &value) {
+	return value.toString().toULongLong();
+}
+
+// The server caps pinned chats and faved stickers at Premium limits,
+// everything beyond is kept as the local extras overlay in this module.
+[[nodiscard]] int PinExtrasChatsLimit() {
+	return PinExtras::kPinnedChatsLimit;
+}
+
+[[nodiscard]] int PinExtrasStickersLimit() {
+	return PinExtras::kFavedStickersLimit;
+}
+
+} // namespace
+
+PinExtras::PinExtras(not_null<Main::Session*> session)
+: _session(session) {
+}
+
+Main::Session &PinExtras::session() const {
+	return *_session;
+}
+
+Data::Session &PinExtras::data() const {
+	return _session->data();
+}
+
+void PinExtras::ensureLoaded() {
+	if (_loaded) {
+		return;
+	}
+	_loaded = true;
+	const auto loadIds = [](const QByteArray &data, auto &&process) {
+		const auto document = QJsonDocument::fromJson(data);
+		if (!document.isArray()) {
+			return;
+		}
+		for (const auto &value : document.array()) {
+			process(ParseId(value));
+		}
+	};
+	loadIds(_session->local().readPref<QByteArray>(
+		kChatsPrefKey,
+		QByteArray()), [=](uint64 value) {
+		_extraPinnedChats.push_back(PeerId(PeerIdHelper(value)));
+	});
+	loadIds(_session->local().readPref<QByteArray>(
+		kFavedPrefKey,
+		QByteArray()), [=](uint64 value) {
+		_extraFavedStickers.push_back(value);
+	});
+}
+
+void PinExtras::persistChats() {
+	auto ids = QJsonArray();
+	for (const auto &peerId : _extraPinnedChats) {
+		ids.append(SerializeId(peerId.bare));
+	}
+	_session->local().writePref<QByteArray>(
+		kChatsPrefKey,
+		QJsonDocument(ids).toJson(QJsonDocument::Compact));
+}
+
+void PinExtras::persistFaved() {
+	auto ids = QJsonArray();
+	for (const auto &id : _extraFavedStickers) {
+		ids.append(SerializeId(id));
+	}
+	_session->local().writePref<QByteArray>(
+		kFavedPrefKey,
+		QJsonDocument(ids).toJson(QJsonDocument::Compact));
+}
+
+void PinExtras::serverChatsApplied(const std::vector<PeerId> &serverPinned) {
+	ensureLoaded();
+	_serverPinnedChats = base::flat_set<PeerId>(
+		serverPinned.begin(),
+		serverPinned.end());
+	auto changed = false;
+	for (auto i = _extraPinnedChats.begin(); i != _extraPinnedChats.cend();) {
+		if (_serverPinnedChats.contains(*i)) {
+			i = _extraPinnedChats.erase(i);
+			changed = true;
+		} else {
+			++i;
+		}
+	}
+	if (changed) {
+		persistChats();
+	}
+}
+
+void PinExtras::serverEntryPinned(not_null<History*> history, bool pinned) {
+	ensureLoaded();
+	const auto peerId = history->peer->id;
+	if (pinned) {
+		_serverPinnedChats.insert(peerId);
+		if (const auto index = _extraPinnedChats.indexOf(peerId); index >= 0) {
+			_extraPinnedChats.removeAt(index);
+			persistChats();
+		}
+	} else {
+		_serverPinnedChats.remove(peerId);
+	}
+}
+
+bool PinExtras::keepLocalPin(not_null<History*> history) const {
+	ensureLoaded();
+	return _extraPinnedChats.contains(history->peer->id);
+}
+
+void PinExtras::chatPinnedLocally(not_null<History*> history, bool pinned) {
+	ensureLoaded();
+	const auto peerId = history->peer->id;
+	if (pinned) {
+		if (_serverPinnedChats.contains(peerId)
+			|| _extraPinnedChats.contains(peerId)) {
+			return;
+		}
+		if (int(_extraPinnedChats.size()) < PinExtrasChatsLimit()) {
+			_extraPinnedChats.push_back(peerId);
+			persistChats();
+		}
+	} else if (const auto index = _extraPinnedChats.indexOf(peerId); index >= 0) {
+		_extraPinnedChats.removeAt(index);
+		persistChats();
+	}
+}
+
+std::vector<PeerId> PinExtras::extraPinnedPeerIds() const {
+	ensureLoaded();
+	auto result = std::vector<PeerId>();
+	result.reserve(_extraPinnedChats.size());
+	for (const auto &peerId : _extraPinnedChats) {
+		result.push_back(peerId);
+	}
+	return result;
+}
+
+bool PinExtras::isExtraPeer(PeerId peerId) const {
+	ensureLoaded();
+	return _extraPinnedChats.contains(peerId);
+}
+
+void PinExtras::serverFavedReceived(const QVector<DocumentData*> &serverFaved) {
+	ensureLoaded();
+	_serverFavedStickers.clear();
+	for (const auto &document : serverFaved) {
+		if (document) {
+			_serverFavedStickers.insert(document->id);
+		}
+	}
+	auto changed = false;
+	for (auto i = _extraFavedStickers.begin(); i != _extraFavedStickers.cend();) {
+		if (_serverFavedStickers.contains(*i)) {
+			i = _extraFavedStickers.erase(i);
+			changed = true;
+		} else {
+			++i;
+		}
+	}
+	if (changed) {
+		persistFaved();
+	}
+}
+
+void PinExtras::chatFavedLocal(not_null<DocumentData*> document) {
+	ensureLoaded();
+	if (_serverFavedStickers.contains(document->id)
+		|| _extraFavedStickers.contains(document->id)) {
+		return;
+	}
+	if (int(_extraFavedStickers.size()) < PinExtrasStickersLimit()) {
+		_extraFavedStickers.push_back(document->id);
+		persistFaved();
+	}
+}
+
+void PinExtras::chatFavedNotLocal(not_null<DocumentData*> document) {
+	ensureLoaded();
+	if (const auto index = _extraFavedStickers.indexOf(document->id); index >= 0) {
+		_extraFavedStickers.removeAt(index);
+		persistFaved();
+	}
+}
+
+QVector<DocumentData*> PinExtras::extraFavedDocuments() const {
+	ensureLoaded();
+	auto result = QVector<DocumentData*>();
+	result.reserve(_extraFavedStickers.size());
+	for (const auto &id : _extraFavedStickers) {
+		result.push_back(data().document(id));
+	}
+	return result;
+}
+
+void PinExtras::push(std::shared_ptr<ChatHelpers::Show> show) {
+	ensureLoaded();
+	auto root = QJsonObject();
+	root.insert(u"kind"_q, u"%1"_q.arg(kBackupKind));
+	root.insert(u"version"_q, 1);
+
+	auto chats = QJsonArray();
+	for (const auto &peerId : extraPinnedPeerIds()) {
+		chats.append(SerializeId(peerId.bare));
+	}
+	root.insert(u"pinnedChats"_q, chats);
+
+	auto stickers = QJsonArray();
+	for (const auto &id : _extraFavedStickers) {
+		stickers.append(SerializeId(id));
+	}
+	root.insert(u"favedStickers"_q, stickers);
+
+	const auto history = data().history(session().userPeerId());
+	session().api().sendFile(
+		QJsonDocument(root).toJson(QJsonDocument::Compact),
+		SendMediaType::File,
+		Api::SendAction(history),
+		u"%1"_q.arg(kBackupFileName));
+	show->showToast(tr::lng_pin_extras_export_done(tr::now));
+}
+
+void PinExtras::pull(std::shared_ptr<ChatHelpers::Show> show) {
+	if (_pulling) {
+		return;
+	}
+	_pulling = true;
+	session().api().request(MTPmessages_GetHistory(
+		MTP_inputPeerSelf(),
+		MTP_int(0), // offset_id
+		MTP_int(0), // offset_date
+		MTP_int(0), // add_offset
+		MTP_int(kPullLimit), // limit
+		MTP_int(0), // max_id
+		MTP_int(0), // min_id
+		MTP_long(0) // hash
+	)).done([=](const MTPmessages_Messages &result) {
+		_pulling = false;
+		auto messages = QVector<MTPMessage>();
+		result.match([&](const MTPDmessages_messages &data) {
+			messages = data.vmessages().v;
+		}, [&](const MTPDmessages_messagesSlice &data) {
+			messages = data.vmessages().v;
+		}, [](const MTPDmessages_messagesNotModified &) {
+		});
+		if (messages.isEmpty()) {
+			show->showToast(tr::lng_pin_extras_import_none(tr::now));
+			return;
+		}
+		auto messageIds = std::vector<MsgId>();
+		messageIds.reserve(messages.size());
+		for (const auto &message : messages) {
+			messageIds.push_back(MsgId(message.match([](const auto &data) {
+				return data.vid().v;
+			})));
+		}
+		data().processMessages(messages, NewMessageType::Existing);
+		readBackup(show, std::move(messageIds));
+	}).fail([=](const MTP::Error &error) {
+		_pulling = false;
+		show->showToast(error.type());
+	}).send();
+}
+
+void PinExtras::readBackup(
+		std::shared_ptr<ChatHelpers::Show> show,
+		std::vector<MsgId> messageIds) {
+	const auto peerId = session().userPeerId();
+	auto found = (HistoryItem*)nullptr;
+	for (auto i = messageIds.rbegin(); i != messageIds.rend(); ++i) {
+		const auto item = data().message(peerId, *i);
+		if (!item) {
+			continue;
+		}
+		const auto media = item->media();
+		const auto document = media ? media->document() : nullptr;
+		if (document && document->filename() == u"%1"_q.arg(kBackupFileName)) {
+			found = item;
+			break;
+		}
+	}
+	if (!found) {
+		show->showToast(tr::lng_pin_extras_import_none(tr::now));
+		return;
+	}
+	const auto path = QDir::tempPath()
+		+ u"/tdesktop-pin-extras-%1.json"_q.arg(session().userId().bare());
+	const auto document = found->media()->document();
+	document->save(
+		Data::FileOrigin(found->fullId()),
+		path,
+		Data::LoadFromCloudOrLocal,
+		false);
+	const auto check = [=](const auto &self, int attempt) -> void {
+		if (QFile::exists(path)) {
+			applyBackup(show, path);
+		} else if (attempt < kPollAttempts) {
+			QTimer::singleShot(kPollInterval, [=] {
+				self(self, attempt + 1);
+			});
+		} else {
+			show->showToast(tr::lng_pin_extras_import_none(tr::now));
+		}
+	};
+	check(check, 0);
+}
+
+void PinExtras::applyBackup(
+		std::shared_ptr<ChatHelpers::Show> show,
+		const QString &path) {
+	auto file = QFile(path);
+	if (!file.open(QIODevice::ReadOnly)) {
+		show->showToast(tr::lng_pin_extras_import_none(tr::now));
+		return;
+	}
+	const auto document = QJsonDocument::fromJson(file.readAll());
+	file.close();
+	if (!document.isObject()
+		|| document.object().value(u"kind"_q).toString() != u"%1"_q.arg(kBackupKind)) {
+		show->showToast(tr::lng_pin_extras_import_none(tr::now));
+		return;
+	}
+	auto chats = 0;
+	auto stickers = 0;
+	for (const auto &value : document.object().value(u"pinnedChats"_q).toArray()) {
+		const auto peerId = PeerId(PeerIdHelper(ParseId(value)));
+		if (const auto history = data().historyLoaded(peerId)) {
+			if (!history->isPinnedDialog(FilterId())) {
